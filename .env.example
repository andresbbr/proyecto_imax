# Copiar a .env (ignorado por Git) y cambiar la contraseña.
# Nunca subir el archivo .env al repositorio.

# Base de datos
POSTGRES_DB=imax
POSTGRES_USER=imax_owner
POSTGRES_PASSWORD=cambiar_esta_clave

# Puerto del host (5433 para no chocar con instalaciones locales de Postgres)
POSTGRES_PORT=5433

# Zona horaria del servidor (las marcas de tiempo se guardan como timestamptz)
TZ=UTC
