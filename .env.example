# Copiar a .env (ignorado por Git) y cambiar las contraseñas.
# Nunca subir el archivo .env al repositorio.
# iniciar.ps1 crea el .env a partir de este archivo si no existe.

# PostgreSQL 16 instalado en el equipo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Superusuario de la instalación, solo para crear la base la primera vez (db/crear_base.sql).
# Si la contraseña se deja vacía, psql la pide al ejecutar iniciar.ps1.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Base del proyecto y su usuario dueño (los crea db/crear_base.sql)
POSTGRES_DB=imax
POSTGRES_USER=imax_owner
POSTGRES_PASSWORD=cambiar_esta_clave

# Zona horaria del contenedor, solo si se usa docker-compose.yml
TZ=UTC

# Aplicación web: contraseña del usuario de conexión imax_app y clave para firmar la sesión
APP_DB_PASSWORD=cambiar_esta_clave_app
APP_SECRET=cambiar_esta_clave_secreta
